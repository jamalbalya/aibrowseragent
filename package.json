{
  "name": "ai-browser-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic AI browser agent for Chrome. The user chooses the AI brain; the extension supplies the agent body.",
  "license": "MIT",
  "author": "jamalbalya",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && node scripts/validate-package.mjs && npm run check:parity",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "verify:full": "npm run verify && npm run test:e2e",
    "check:parity": "node scripts/check-parity.mjs",
    "build:release": "RELEASE_BUILD=1 node scripts/build.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "verify:release": "npm run build:release && node scripts/validate-package.mjs && npm run validate:release"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.1.28",
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^5.0.1"
  }
}
