# Backend configuration for the OPTIONAL identity/authentication service.
#
# NOTHING HERE IS NEEDED TO BUILD, TEST OR USE THE CHROME EXTENSION.
# `npm ci && npm test && npm run build` requires no value from this file and
# no service to be running. These names matter only to somebody deploying the
# optional backend; see docs/architecture/LOCAL_FIRST_ARCHITECTURE.md §11.
#
# Names only. Every value is intentionally empty: a committed default for a
# secret is a production secret the first time somebody forgets to override
# it, and `loadConfig` refuses to start rather than fall back to one.
#
# `.env` and `.env.*` are gitignored; this file is the one exception, and it
# exists so the required set is discoverable without any value being present.

# The origin the backend is reachable at. Used to build redirect URIs.
ABA_PUBLIC_ORIGIN=

# SECRET. Signs access tokens. Generate with a CSPRNG; never reuse across
# environments, because a shared key makes a staging token valid in production.
ABA_ACCESS_TOKEN_SIGNING_KEY=

# SECRET. Database connection string for the optional backend's managed
# database. Not a local install: the deployment target is a hosted service
# that applies migrations on deploy. Never needed on a development machine.
ABA_DATABASE_URL=

# Google sign-in. Configured as a pair or not at all: a backend with neither
# is a working backend whose Google routes are simply absent, and half a
# client is refused at startup rather than mid sign-in.
ABA_GOOGLE_CLIENT_ID=

# SECRET. Redeems Google authorization codes. Server-side only: it never
# reaches the extension, the manifest, dist/, Chrome storage or a URL. The
# authorization-code flow exists so the client needs nothing to redeem with.
ABA_GOOGLE_CLIENT_SECRET=

# Optional. One of: debug, info, warn, error. Defaults to info.
ABA_LOG_LEVEL=
